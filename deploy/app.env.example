# Copy to app.env (mode 600). Values double-quoted, $$ for a literal $.
# Any secret below can instead come from a file: set NAME_FILE to its path
# (ANSIBLE_GUI_SECRET_KEY, ANSIBLE_GUI_OIDC_CLIENT_SECRET, ANSIBLE_GUI_SMTP_PASSWORD).
#
# Not here on purpose: ANSIBLE_GUI_HOST, ANSIBLE_GUI_PORT and ANSIBLE_GUI_DATA_DIR are
# set by the image (0.0.0.0, 8080, /data) and the compose file depends on them.

# --- Sign-in (required: the app refuses to listen on 0.0.0.0 without it) ---
# The address people use. Besides localhost, its host is the only name the app answers to,
# so it has to match the Traefik Host rule in docker-compose.yml.
ANSIBLE_GUI_PUBLIC_URL="https://ansible.nanestor.us"
ANSIBLE_GUI_OIDC_ISSUER="https://id.nanestor.us"
# Both come from the Pocket ID client; nothing to generate here.
ANSIBLE_GUI_OIDC_CLIENT_ID=""
ANSIBLE_GUI_OIDC_CLIENT_SECRET=""
# Comma-separated groups allowed in, or * for anyone the provider signs in.
ANSIBLE_GUI_OIDC_GROUPS="admins"
# Traefik's address on ansible-gui_edge, so X-Forwarded-For/Proto are believed.
# Empty trusts no proxy; unset trusts only 127.0.0.1.
ANSIBLE_GUI_TRUSTED_PROXIES=""

# --- Master key for sessions and stored credentials ---
# Kept out of ./data so a copy of the data alone can't decrypt credentials.
# At least 32 characters. Create it once, next to docker-compose.yml:
#   (umask 077; openssl rand -base64 48 > secret.key) && sudo chown 10001 secret.key
# The container runs as uid 10001, so it can't read a mode-600 file you own.
# Back it up apart from ./data: a changed or lost key makes every stored
# credential unreadable (they have to be entered again) and signs everyone out.
ANSIBLE_GUI_SECRET_KEY_FILE="/run/secrets/ansible-gui-key"

# --- Runs (optional) ---
# The only ssh_config runs read (ssh -F). Absolute path inside the container;
# unset means -F none. Deploy keys and known hosts are managed in the UI.
# ANSIBLE_GUI_SSH_CONFIG="/data/ssh_config"
# accept-new (default): trust a new host's first answer and record its key under Known
# hosts on the Credentials page; a changed key is refused after that. yes: reach only
# hosts whose key is already listed there. no: trust any answer, so anyone in the path
# can pose as a host and get the become password.
# ANSIBLE_GUI_SSH_HOST_KEY_CHECKING="accept-new"
# Finished runs (history and logs) older than this many days are deleted; 0 keeps all.
# ANSIBLE_GUI_RUN_RETENTION_DAYS="90"
# Runs go one at a time, so one that hangs holds up every run behind it. One still going after this
# many minutes is stopped and marked failed; 0 for no limit.
# ANSIBLE_GUI_RUN_TIMEOUT_MINUTES="120"
# Server-wide vault password file, used when a run picks no vault credential.
# Prefer a vault password stored on the Credentials page.
# ANSIBLE_GUI_VAULT_PASSWORD_FILE="/run/secrets/vault-pass"

# --- Email for schedules and failed pulls (optional) ---
# Setting SMTP_HOST makes SMTP_FROM and NOTIFY_TO required.
# ANSIBLE_GUI_SMTP_HOST=""
# ANSIBLE_GUI_SMTP_FROM=""
# Comma-separated addresses.
# ANSIBLE_GUI_NOTIFY_TO=""
# starttls (default, port 587), ssl (465) or none (25).
# ANSIBLE_GUI_SMTP_TLS="starttls"
# ANSIBLE_GUI_SMTP_PORT=""
# ANSIBLE_GUI_SMTP_USERNAME=""
# ANSIBLE_GUI_SMTP_PASSWORD=""

# --- Local checkout instead of repositories added in the UI (not used on docker01) ---
# ANSIBLE_GUI_PROJECT_DIR=""
# Comma-separated, relative to PROJECT_DIR.
# ANSIBLE_GUI_INVENTORY="inventory"
# ANSIBLE_GUI_PLAYBOOK_DIR="."
# e.g. https://git.example.com/me/ansible/src/branch/main/{path}#L{line}
# ANSIBLE_GUI_EDIT_URL=""
